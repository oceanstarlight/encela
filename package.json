{
  "name": "encela",
  "version": "0.2.0",
  "description": "Encela for Claude Code: one prompt in, and Claude drafts a blueprint, picks the pieces (MCP servers, CLIs, skills, rules, subagents) it needs, asks you to approve, then assembles and builds.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanstarlight/encela.git"
  },
  "homepage": "https://github.com/oceanstarlight/encela#readme",
  "keywords": [
    "claude-code",
    "mcp",
    "mcp-server",
    "skills",
    "plugin",
    "orchestration",
    "cli"
  ],
  "type": "module",
  "bin": {
    "encela": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node build.mjs --test && node --test test/*.test.mjs",
    "check:view": "node scripts/check-view.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  }
}
