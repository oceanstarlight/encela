{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!catalog", "!dist", "!test/fixtures/jq-cases.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/jq.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noVoidTypeReturn": "off",
            "noPrecisionLoss": "off"
          },
          "suspicious": {
            "noShadowRestrictedNames": "off",
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["test/fixtures/jq-cases.gen.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noThenProperty": "off"
          }
        }
      }
    }
  ]
}
